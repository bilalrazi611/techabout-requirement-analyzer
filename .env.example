# LLM Provider: groq | openai | ollama | none
LLM_PROVIDER=groq

# Groq (recommended – free tier, fast)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI (optional)
OPENAI_API_KEY=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Model override (optional)
# Groq examples: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# OpenAI examples: gpt-4o-mini, gpt-4o
MODEL_NAME=

# App
APP_NAME=TechAbout Requirement Analyzer
DEBUG=false
